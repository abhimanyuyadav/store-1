# Convex production deployment
CONVEX_DEPLOYMENT=your-org-your-project
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Server-only bootstrap secret used once to create the first admin
ADMIN_SETUP_KEY=generate-a-long-random-secret
